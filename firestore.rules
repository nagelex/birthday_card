rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidBirthdayCard(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
          && data.mainWish is string && data.mainWish.size() <= 1000
          && data.wishes is list && data.wishes.size() <= 50
          && data.songUrl is string && data.songUrl.size() <= 600
          && (data.get('lyrics', '') is string && data.get('lyrics', '').size() <= 5000)
          && data.createdAt is timestamp;
    }

    match /cards/{cardId} {
      allow get: if isValidId(cardId);
      allow create: if isValidId(cardId) && isValidBirthdayCard(request.resource.data)
                    && request.resource.data.createdAt == request.time;
    }
  }
}
